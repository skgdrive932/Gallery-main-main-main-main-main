<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="135" android:startColor="#1B2730" android:endColor="#607783" />
            <stroke android:width="1dp" android:color="#9BB0BC" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="135" android:startColor="#4D5E68" android:centerColor="#1E2A32" android:endColor="#080B0E" />
            <stroke android:width="1dp" android:color="#596A75" />
        </shape>
    </item>
</selector>
