<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#0A0E12" />
            <stroke android:width="2dp" android:color="#50616D" />
            <padding android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp" />
        </shape>
    </item>
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="oval">
            <gradient android:angle="135" android:startColor="#687984" android:centerColor="#27343D" android:endColor="#080B0E" />
            <stroke android:width="1dp" android:color="#81909A" />
        </shape>
    </item>
</layer-list>
