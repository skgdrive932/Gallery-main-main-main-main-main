<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#286889" />
            <stroke android:width="1dp" android:color="#65C8EF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1A3446" />
            <stroke android:width="1dp" android:color="#38576A" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
