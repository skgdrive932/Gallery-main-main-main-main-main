<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/symbian_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_toolbar"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">
        <TextView android:id="@+id/menuButton" android:layout_width="34dp" android:layout_height="44dp" android:gravity="center" android:text="☰" android:textColor="@color/symbian_white" android:textSize="24sp"/>
        <TextView android:id="@+id/titleText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MANI Gallery" android:textColor="@color/symbian_white" android:textSize="21sp" android:textStyle="bold" android:shadowColor="#000000" android:shadowDx="2" android:shadowDy="2" android:shadowRadius="3"/>
        <TextView android:id="@+id/countText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="10dp" android:textColor="@color/symbian_white" android:textSize="12sp"/>
        <TextView android:id="@+id/aboutButton" android:layout_width="42dp" android:layout_height="44dp" android:gravity="center" android:text="⋮" android:textColor="@color/symbian_white" android:textSize="25sp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:padding="8dp" android:background="#162D3D">
        <EditText android:id="@+id/searchInput" android:layout_width="match_parent" android:layout_height="40dp" android:background="@drawable/bg_search" android:hint="🔍  Search photos and videos" android:textColorHint="#A9BFCA" android:textColor="@color/symbian_white" android:singleLine="true" android:textSize="14sp" android:paddingStart="16dp" android:paddingEnd="16dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/tabBar" android:layout_width="match_parent" android:layout_height="54dp" android:background="#1A3446" android:weightSum="4">
        <TextView android:id="@+id/tabPhotos" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="📷\nPhotos" android:textColor="@color/symbian_white" android:textSize="11sp" android:background="@drawable/bg_tab_selected"/>
        <TextView android:id="@+id/tabVideos" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▶\nVideos" android:textColor="#A9BFCA" android:textSize="11sp" android:background="@drawable/bg_tab"/>
        <TextView android:id="@+id/tabAlbums" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▣\nAlbums" android:textColor="#A9BFCA" android:textSize="11sp" android:background="@drawable/bg_tab"/>
        <TextView android:id="@+id/tabFavorites" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="♥\nFavorites" android:textColor="#A9BFCA" android:textSize="11sp" android:background="@drawable/bg_tab"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="55dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#142B3B">
        <TextView android:id="@+id/sectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Photos" android:textColor="@color/symbian_white" android:textSize="18sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_toggle" android:padding="2dp">
            <TextView android:id="@+id/gridButton" android:layout_width="42dp" android:layout_height="32dp" android:gravity="center" android:text="2D" android:textColor="@color/symbian_white" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/bg_toggle_selected"/>
            <TextView android:id="@+id/roundButton" android:layout_width="42dp" android:layout_height="32dp" android:gravity="center" android:text="3D" android:textColor="#A9C2CE" android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:id="@+id/btnSelect" android:layout_width="58dp" android:layout_height="36dp" android:layout_marginStart="8dp" android:gravity="center" android:text="Select" android:textColor="@color/symbian_white" android:textSize="12sp" android:background="@drawable/bg_toggle_selected" />
    </LinearLayout>

    <LinearLayout android:id="@+id/selectionBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="92dp" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:background="#102A3B" android:visibility="gone" android:elevation="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/selectionCount" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="0 selected" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/btnSelectAll" android:layout_width="72dp" android:layout_height="34dp" android:gravity="center" android:text="☑ All" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/bg_toggle_selected" />
            <TextView android:id="@+id/btnCancelSelection" android:layout_width="42dp" android:layout_height="38dp" android:layout_marginStart="5dp" android:gravity="center" android:text="✕" android:contentDescription="Cancel selection" android:textColor="#FFFFFF" android:textSize="20sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="5dp" android:orientation="horizontal" android:gravity="center" android:weightSum="3">
            <TextView android:id="@+id/btnShareSelected" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="↗  Share" android:textColor="#FFFFFF" android:textSize="13sp" android:background="@drawable/bg_toggle" />
            <TextView android:id="@+id/btnMoveSelected" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:gravity="center" android:text="↪  Move" android:textColor="#FFFFFF" android:textSize="13sp" android:background="@drawable/bg_toggle" />
            <TextView android:id="@+id/btnDeleteSelected" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center" android:text="▤  Delete" android:textColor="#FFD0D0" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/bg_toggle" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/permissionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="11dp" android:text="Allow photo and video access to view your gallery." android:textColor="@color/symbian_text" android:background="#286889" android:visibility="gone"/>
    <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="22dp" android:text="No media found" android:textColor="@color/symbian_text" android:textSize="15sp" android:visibility="gone"/>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/mediaRecycler" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="6dp" android:clipToPadding="false"/>
        <com.sk.symbiangallery.RoundGalleryView android:id="@+id/roundGallery" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
    </FrameLayout>

</LinearLayout>
