<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <com.sk.symbiangallery.GesturePlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:keepScreenOn="true" />

    <!-- Clean MX-style top overlay -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:background="@drawable/bg_player_top">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:background="@android:color/transparent"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/videoTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="8dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/btnSubtitleTop"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="CC"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_player_icon_button"
            android:contentDescription="Subtitles" />

        <TextView
            android:id="@+id/btnAudioOnlyTop"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:text="♫"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="@drawable/bg_player_icon_button"
            android:contentDescription="Audio" />

        <TextView
            android:id="@+id/btnInfo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:text="ⓘ"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="@drawable/bg_player_icon_button"
            android:contentDescription="Video information" />

        <TextView
            android:id="@+id/btnMore"
            android:layout_width="34dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:contentDescription="More" />
    </LinearLayout>

    <!-- Gesture feedback: brightness on left, volume on right -->
    <LinearLayout
        android:id="@+id/brightnessHud"
        android:layout_width="66dp"
        android:layout_height="154dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="30dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/bg_player_hud"
        android:padding="10dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀" android:textColor="#FFFFFF" android:textSize="21sp" />
        <ProgressBar android:id="@+id/brightnessProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="42dp" android:layout_height="6dp" android:layout_marginTop="12dp" android:progress="50" android:max="100" android:progressTint="#FFFFFF" />
        <TextView android:id="@+id/brightnessValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="50%" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/volumeHud"
        android:layout_width="66dp"
        android:layout_height="154dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="30dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/bg_player_hud"
        android:padding="10dp">
        <TextView android:id="@+id/volumeIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔊" android:textSize="18sp" />
        <ProgressBar android:id="@+id/volumeProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="42dp" android:layout_height="6dp" android:layout_marginTop="12dp" android:progress="50" android:max="100" android:progressTint="#FFFFFF" />
        <TextView android:id="@+id/volumeValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="50%" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Center controls: familiar media-player layout -->
    <LinearLayout
        android:id="@+id/centerControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCenterBack10"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:text="↶\n10"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/bg_player_center_button" />

        <TextView
            android:id="@+id/btnPrev"
            android:layout_width="48dp"
            android:layout_height="58dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:text="|‹"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/btnPlay"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#111111"
            android:textSize="26sp"
            android:background="@drawable/bg_player_play"
            android:contentDescription="Play or pause" />

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="48dp"
            android:layout_height="58dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:text="›|"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/btnCenterForward10"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:text="10\n↷"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/bg_player_center_button" />
    </LinearLayout>

    <!-- Bottom overlay -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="9dp"
        android:background="@drawable/bg_player_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/positionText" android:layout_width="52dp" android:layout_height="wrap_content" android:text="00:00" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
            <SeekBar android:id="@+id/seekBar" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:max="1000" android:progress="0" android:progressTint="#FFFFFF" android:thumbTint="#FFFFFF" />
            <TextView android:id="@+id/remainingText" android:layout_width="58dp" android:layout_height="wrap_content" android:gravity="end" android:text="-00:00" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/btnLock" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="🔒" android:textSize="17sp" android:background="@android:color/transparent" android:contentDescription="Lock" />
            <TextView android:id="@+id/btnSpeed" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="1×" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:background="@drawable/bg_player_icon_button" android:contentDescription="Speed" />
            <TextView android:id="@+id/btnAudio" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="5dp" android:gravity="center" android:text="♫" android:textColor="#FFFFFF" android:textSize="18sp" android:background="@drawable/bg_player_icon_button" android:contentDescription="Audio track" />
            <TextView android:id="@+id/btnSubtitle" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="5dp" android:gravity="center" android:text="CC" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_player_icon_button" android:contentDescription="Subtitle" />

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView android:id="@+id/btnBack10" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="↶" android:textColor="#FFFFFF" android:textSize="19sp" android:background="@android:color/transparent" />
            <TextView android:id="@+id/btnRadial" android:layout_width="48dp" android:layout_height="44dp" android:gravity="center" android:text="⋯" android:textColor="#FFFFFF" android:textSize="24sp" android:background="@android:color/transparent" android:contentDescription="More controls" />
            <TextView android:id="@+id/btnForward10" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="↷" android:textColor="#FFFFFF" android:textSize="19sp" android:background="@android:color/transparent" />
            <TextView android:id="@+id/btnFullscreen" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="⛶" android:textColor="#FFFFFF" android:textSize="20sp" android:background="@android:color/transparent" android:contentDescription="Fullscreen" />
        </LinearLayout>
    </LinearLayout>

    <!-- Small options sheet instead of a large radial wheel -->
    <LinearLayout
        android:id="@+id/radialMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="106dp"
        android:padding="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        android:background="@drawable/bg_player_options">
        <TextView android:id="@+id/btnAspect" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:gravity="center" android:text="Fit" android:textColor="#FFFFFF" android:textSize="11sp" />
        <TextView android:id="@+id/btnRepeat" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:gravity="center" android:text="A-B" android:textColor="#FFFFFF" android:textSize="11sp" />
        <TextView android:id="@+id/btnFrame" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:gravity="center" android:text="Frame" android:textColor="#FFFFFF" android:textSize="11sp" />
        <TextView android:id="@+id/btnFile" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:gravity="center" android:text="Open" android:textColor="#FFFFFF" android:textSize="11sp" />
        <TextView android:id="@+id/btnPipTop" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:gravity="center" android:text="PiP" android:textColor="#FFFFFF" android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/gestureOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_hud"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Kept for source compatibility; hidden legacy quick-action IDs -->
    <TextView android:id="@+id/btnSpeedTop" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp" />
    <TextView android:id="@+id/btnScreenshotTop" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp" />
    <TextView android:id="@+id/btnFitTop" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp" />
    <TextView android:id="@+id/btnDecoder" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp" />

</FrameLayout>
